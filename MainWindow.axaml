<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Gestor_de_Tareas.ModelosDeVista"
        xmlns:modelos="using:Gestor_de_Tareas.Modelos"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Gestor_de_Tareas.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Gestor de tareas"
        Width="900" Height="600"
        MinWidth="760" MinHeight="500">

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="330,*" Margin="16">
        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,0,12,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Datos de la tarea" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />

                <TextBlock Text="Titulo" />
                <TextBox Text="{Binding Title, Mode=TwoWay}" MaxLength="100" Watermark="Escribe el titulo" />

                <TextBlock Text="Descripcion" />
                <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="96" MaxLength="500"
                         Watermark="Escribe una descripcion" />

                <TextBlock Text="Prioridad" />
                <ComboBox ItemsSource="{Binding Priorities}"
                          SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Text="Estado" />
                <ComboBox ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Content="Nuevo" Click="OnNewClick" />
                    <Button Content="Guardar" Click="OnCreateClick" />
                    <Button Content="Actualizar" Click="OnUpdateClick" />
                    <Button Content="Eliminar" Click="OnDeleteClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <TextBlock Text="Tareas registradas" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
                <ListBox ItemsSource="{Binding Tasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         SelectionChanged="OnSelectionChanged"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="modelos:TaskItem">
                            <Grid ColumnDefinitions="40,2*,90,100,170" Margin="4,6">
                                <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding PriorityLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,8,0,0"
                       Text="No hay tareas registradas. Usa el boton Nuevo para comenzar."
                       IsVisible="{Binding IsEmpty}" />
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="10"
                CornerRadius="4" Background="#EEF3FA">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
